require "bundler/gem_tasks"

<% if @test_framework == :minitest -%>
require "minitest/test_task"
<% elsif @test_framework == :rspec -%>
require "rspec/core/rake_task"
<% end -%>

<% if @test_framework == :minitest -%>
Minitest::TestTask.create
<% elsif @test_framework == :rspec -%>
RSpec::Core::RakeTask.new(:spec)
<% end -%>

require "rubocop/rake_task"
RuboCop::RakeTask.new

require "gempilot/version_task"
Gempilot::VersionTask.new

require "gempilot/zeitwerk_task"
Gempilot::ZeitwerkTask.new

require "gempilot/rbs_task"
Gempilot::RBSTask.new

<% if @test_framework == :minitest -%>
task default: [:test, :rubocop, "rbs:validate"]
<% elsif @test_framework == :rspec -%>
task default: [:spec, :rubocop, "rbs:validate"]
<% end -%>
