<% if @hyphenated -%>
require "<%= @require_path %>"
<% else -%>
require "zeitwerk"

##
# Top-level namespace for the <%= @gem_name %> gem.
module <%= @module_name %>
  LOADER = Zeitwerk::Loader.for_gem.tap(&:setup)

  ##
  # Base error class for <%= @gem_name %>.
  class Error < StandardError; end
end
<% end -%>
