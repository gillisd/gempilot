source "https://rubygems.org"

gemspec

<% if @gempilot_path -%>
gem "gempilot", path: <%= @gempilot_path.inspect %>, require: false
<% else -%>
gem "gempilot", require: false
<% end -%>
gem "irb"
gem "json", "~> 2.21" # temporary json 3.0.0 is currently breaking everything
<% if @test_framework == :minitest -%>
gem "minitest"
gem "minitest-reporters"
<% end -%>
gem "rake"
gem "rbs"
<% if @test_framework == :rspec -%>
gem "rspec", "~> 3.0"
<% end -%>
gem "rubocop"
gem "rubocop-claude"
<% if @test_framework == :minitest -%>
gem "rubocop-minitest"
<% end -%>
gem "rubocop-performance"
gem "rubocop-rake"
<% if @test_framework == :rspec -%>
gem "rubocop-rspec"
<% end -%>
